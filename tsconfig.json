{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "removeComments": true,
    // load-bearing if target ever moves to ES2022+: Pt extends Float32Array
    // relies on constructor-assignment (set) semantics for class fields
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
