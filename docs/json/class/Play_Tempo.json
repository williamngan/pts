      ],
      "flags": {},
      "overrides": false,
      "inherits": false,
      "signatures": [
        {
          "comment": "This is a core function that let you specify a rhythm and then define responses by calling the `start` and `progress` functions from the returned object. See [Animation guide](../guide/Animation-0700.html) for more details.\nThe `start` function lets you set a callback on every start. It takes a function ([`ITempoStartFn`](#link)).\nThe `progress` function lets you set a callback during progress. It takes a function ([`ITempoProgressFn`](#link)). Both functions let you optionally specify a time offset and a custom name.\nA positive offset shifts the beat earlier (fires sooner), a negative offset shifts it later.",
          "returns": "ITempoResponses",
          "returns_comment": "an object with chainable functions",
          "parameters": [
            {
              "name": "beats",
              "comment": "a rhythm in beats as a number or an array of numbers",
              "type": "number | number[]",
              "default": false
            }
          ],
          "tags": [
            {
              "tag": "example",
              "text": "`tempo.every(2).start( (count) => ... )`, `tempo.every([2,4,6]).progress( (count, t) => ... )`"
            }
          ]
        }
      ]
    },
