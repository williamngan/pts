      "signatures": [
        {
          "comment": "Create a `World` for 2D physics simulation.",
          "returns": "World",
          "returns_comment": false,
          "parameters": [
            {
              "name": "bound",
              "comment": "a Group or an Iterable<Pt> representing a rectangular bounding box",
              "type": "PtIterable",
              "default": false
            },
            {
              "name": "friction",
              "comment": "a value between 0 to 1, where 1 means no friction. Default is 1",
              "type": "number",
              "default": "1"
            },
            {
              "name": "gravity",
              "comment": "a number of a Pt to define gravitational force. A number is a shorthand to set `new Pt(0, n)`. Default is 0.",
              "type": "number | PtLike",
              "default": "0"
            }
          ],
          "tags": []
        }
      ]
    }
