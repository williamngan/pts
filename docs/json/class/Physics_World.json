        {
          "comment": "Integrate a particle for one substep: Verlet with the accumulated force plus gravity as\nacceleration, and the substep-adjusted friction as drag. Forces are read but not cleared\nhere — they persist across the substeps of one update and are cleared when it completes.",
          "returns": "Particle",
          "returns_comment": false,
          "parameters": [
            {
              "name": "p",
              "comment": "particle",
              "type": "Particle",
              "default": false
            },
            {
              "name": "dt",
              "comment": "substep time in seconds",
              "type": "number",
              "default": false
            },
            {
              "name": "prevDt",
              "comment": "time in seconds spanned by the particle's current displacement (see [`Particle.timeStep`](#link)); the velocity is rescaled to `dt` so that it is preserved when the step size changes.",
              "type": "number",
              "default": "..."
            }
          ],
          "tags": []
        }
