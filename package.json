{
  "name": "pts",
  "version": "0.12.9",
  "description": "A library for visualization and creative coding.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/*.ts"
  ],
  "sideEffects": [
    "./dist/pts.js",
    "./dist/pts.min.js"
  ],
  "unpkg": "./dist/pts.min.js",
  "jsdelivr": "./dist/pts.min.js",
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:docs": "node scripts/docs-smoke.mjs",
    "test:integrations": "node scripts/check-integrations.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "check:docs": "node scripts/generate-docs.mjs --check && pnpm test:docs",
    "check:package": "node scripts/check-package.mjs",
    "check:publishing": "publint && attw --pack .",
    "lint": "eslint src scripts test/integrations *.config.*",
    "format": "prettier --write README.md 'plans/**/*.md' package.json tsconfig.json '*.config.*' 'scripts/**/*.mjs' 'src/**/*.ts' '.github/**/*.yml' '.prettierrc.json' '.vscode/*.json' 'test/integrations/**/*.{css,html,json,md,mjs,ts,tsx,vue}'",
    "format:check": "prettier --check README.md 'plans/**/*.md' package.json tsconfig.json '*.config.*' 'scripts/**/*.mjs' 'src/**/*.ts' '.github/**/*.yml' '.prettierrc.json' '.vscode/*.json' 'test/integrations/**/*.{css,html,json,md,mjs,ts,tsx,vue}'",
    "format:watch": "chokidar README.md 'plans/**/*.md' package.json tsconfig.json '*.config.*' 'scripts/**/*.mjs' 'src/**/*.ts' '.github/**/*.yml' '.prettierrc.json' '.vscode/*.json' 'test/integrations/**/*.{css,html,json,md,mjs,ts,tsx,vue}' -c \"prettier --write --ignore-unknown \\\"{path}\\\"\"",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm check:docs && pnpm build && pnpm check:artifacts && pnpm test:browser && pnpm check:package && pnpm test:integrations && pnpm check:publishing",
    "prepack": "pnpm build",
    "docs": "node scripts/generate-docs.mjs"
  },
  "keywords": [
    "canvas",
    "creative-coding",
    "graphics",
    "svg",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamngan/pts.git"
  },
  "author": "William Ngan",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "chokidar-cli": "3.0.0",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "bugs": {
    "url": "https://github.com/williamngan/pts/issues"
  },
  "homepage": "https://ptsjs.org"
}
